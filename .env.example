# Copy to .env locally. Never commit real keys.
APP_ENV=development
LOG_LEVEL=INFO
DATA_ROOT=data/raw
PROCESSED_ROOT=data/processed
TENANT_ID=demo
PARSER_VERSION=parser-v1
CLEANER_VERSION=cleaner-v1
CHUNKER_VERSION=chunker-v1
MAX_FILE_SIZE_MB=50

# OpenAI-compatible LLM endpoint (configure in Phase 2)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Retrieval services (configure in Phase 1)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=pre_sales_knowledge
EMBEDDING_MODEL=
RERANKER_MODEL=

# Safety and observability
MAX_AGENT_STEPS=4
REQUEST_TIMEOUT_SECONDS=60
ENABLE_CONTENT_LOGGING=false

